# ─── AWS Bedrock (Primary LLM) ──────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Sarvam AI (Fallback LLM) ────────────────────────────────
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1

# ─── MongoDB ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=mental_health

# ─── LLM Configuration ──────────────────────────────────
PRIMARY_MODEL=google.gemma-2-9b-it
FALLBACK_MODEL=sarvam-2b
LLM_TEMPERATURE=0.7

# ─── MongoDB Graph Traversal ─────────────────────────────
GRAPH_TRAVERSAL_DEPTH=2

# ─── Security & Privacy ──────────────────────────────────
ENCRYPTION_SECRET_KEY=gAAAAABl_secret_key_placeholder_32bytes_len=
ENFORCE_PII_ANONYMIZATION=True

# ─── Crisis Helplines ─────────────────────────────────────
CRISIS_HELPLINE_TELE_MANAS=14416
CRISIS_HELPLINE_AASRA=+91-9820466726
CRISIS_HELPLINE_KIRAN=1800-599-0019
CRISIS_HELPLINE_VANDREVALA=+91-9999666555

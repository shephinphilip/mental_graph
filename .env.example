# ─── AWS Bedrock (Exclusive LLM Provider) ─────────────────────
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1

BEDROCK_MODEL=google.gemma-3-27b-it
BEDROCK_GEMMA_MODEL_ID=google.gemma-3-27b-it
BEDROCK_SARVAM_MODEL_ID=sarvam.sarvam-m:0

PRIMARY_MODEL=google.gemma-3-27b-it
# Deprecated compatibility alias; fallback is pinned to BEDROCK_SARVAM_MODEL_ID.
FALLBACK_MODEL=sarvam.sarvam-m:0
LLM_TEMPERATURE=0.7

# ─── MongoDB ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=mental_health
GRAPH_TRAVERSAL_DEPTH=2

# ─── Security & Privacy ──────────────────────────────────
ENCRYPTION_SECRET_KEY=gAAAAABl_secret_key_placeholder_32bytes_len=
ENFORCE_PII_ANONYMIZATION=True
AUTH_SIGNING_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=43200

# ─── Adaptive Psychological Memory ───────────────────────
APM_RECOMMENDATION_CONFIDENCE=0.4
APM_TRIGGER_DECAY_PER_DAY=0.002
APM_EVOLUTION_DECAY_PER_DAY=0.003
APM_RECOVERY_DECAY_PER_DAY=0.02
APM_REINFORCEMENT_DECAY_PER_DAY=0.01
APM_FAILURE_PENALTY=0.12

# ─── Crisis Helplines ─────────────────────────────────────
CRISIS_HELPLINE_TELE_MANAS=14416
CRISIS_HELPLINE_AASRA=+91-9820466726
CRISIS_HELPLINE_KIRAN=1800-599-0019
CRISIS_HELPLINE_VANDREVALA=+91-9999666555

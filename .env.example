# ─── Required API Keys ───────────────────────────────────
GEMINI_API_KEY
OPENAI_API_KEY
NVIDIA_API_KEY
# ─── MongoDB ─────────────────────────────────────────────
MONGODB_URI
DATABASE_NAME

# ─── Neo4j (Graph RAG) ──────────────────────────────────
NEO4J_URI
NEO4J_USER
NEO4J_PASSWORD
GRAPH_TRAVERSAL_DEPTH=2

# ─── LLM Configuration ──────────────────────────────────
PRIMARY_MODEL=gemini-1.5-pro
FALLBACK_MODEL=gpt-4o
LLM_TEMPERATURE=0.7

# ─── AWS Bedrock (Exclusive LLM Provider) ─────────────────────
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1

BEDROCK_MODEL=google.gemma-3-27b-it
BEDROCK_GEMMA_MODEL_ID=google.gemma-3-27b-it
BEDROCK_SARVAM_MODEL_ID=sarvam.sarvam-m:0

PRIMARY_MODEL=google.gemma-3-27b-it
# Deprecated compatibility alias; fallback is pinned to BEDROCK_SARVAM_MODEL_ID.
FALLBACK_MODEL=sarvam.sarvam-m:0
LLM_TEMPERATURE=0.7

# ─── MongoDB ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=mental_health
MONGO_URI=
MONGO_DB_NAME=
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000
GRAPH_TRAVERSAL_DEPTH=2

# ─── Process ─────────────────────────────────────────────
APP_ENV=development
# Settings logger levels: DEBUG, INFO, WARNING (ERROR/CRITICAL also accepted).
LOG_LEVEL=INFO
CORS_ORIGINS=
TRUSTED_HOSTS=
DEFAULT_LIMIT=50
MAX_LIMIT=90
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_STREAM_PER_MINUTE=30
RATE_LIMIT_REPORT_PER_MINUTE=10
RATE_LIMIT_VOICE_STT_PER_MINUTE=20
RATE_LIMIT_VOICE_SESSION_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# ── Sarvam speech (backend only — never send to Streamlit/browser) ─
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3
VOICE_STT_TIMEOUT=30
VOICE_TTS_TIMEOUT=30
VOICE_LLM_TIMEOUT=45
MAX_AUDIO_FILE_SIZE=10485760
MAX_AUDIO_DURATION_SECONDS=60
MAX_CONCURRENT_VOICE_SESSIONS=50
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=16

# ─── Security & Privacy ──────────────────────────────────
ENCRYPTION_SECRET_KEY=gAAAAABl_secret_key_placeholder_32bytes_len=
ENFORCE_PII_ANONYMIZATION=True
AUTH_SIGNING_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=43200

# ─── Adaptive Psychological Memory ───────────────────────
APM_RECOMMENDATION_CONFIDENCE=0.4
APM_TRIGGER_DECAY_PER_DAY=0.002
APM_EVOLUTION_DECAY_PER_DAY=0.003
APM_RECOVERY_DECAY_PER_DAY=0.02
APM_REINFORCEMENT_DECAY_PER_DAY=0.01
APM_FAILURE_PENALTY=0.12

# ─── Longitudinal Pattern Detection ──────────────────────
PATTERN_EMERGING_MIN_EVIDENCE=3
PATTERN_ESTABLISHED_MIN_EVIDENCE=5
PATTERN_RETRIEVAL_MAX=3
PATTERN_RETRIEVAL_MIN_CONFIDENCE=0.4
PATTERN_DECAY_PER_DAY=0.01
PATTERN_INACTIVE_DAYS=45
PATTERN_BASELINE_WINDOW_DAYS=30
PATTERN_LOOKBACK_DAYS=60
PATTERN_FEEDBACK_CONFIRM_BOOST=0.08
PATTERN_FEEDBACK_DISAGREE_PENALTY=0.15
PATTERN_CONTRADICTION_PENALTY=0.10

# Recent sleep window injected into chat and session reports.
SLEEP_CONTEXT_DAYS=7
JOURNAL_CONTEXT_LIMIT=5
JOURNAL_PREVIEW_CHARS=180
JOURNAL_CONTEXT_MAX_CHARS=1200

# ─── Dynamic 1–10 risk window ────────────────────────────
RISK_HIGH_THRESHOLD=8.0
RISK_WINDOW_TURNS=3
RISK_ROLLING_HOURS=6
RISK_CARD_COOLDOWN_HOURS=72

# ─── Meditation ranking (see docs/MEDITATION_RECOMMENDATION.md) ─
MEDITATION_WEIGHT_PAD=0.28
MEDITATION_WEIGHT_LATENT=0.24
MEDITATION_WEIGHT_FRICTION=0.16
MEDITATION_WEIGHT_COGNITIVE=0.12
MEDITATION_WEIGHT_PERSONAL=0.16
MEDITATION_WEIGHT_RECENCY=0.04
MEDITATION_REPETITION_PENALTY=0.18
MEDITATION_REPETITION_FULL_HOURS=12
MEDITATION_REPETITION_ZERO_HOURS=72
MEDITATION_COLD_START_PAD=0.09
MEDITATION_COLD_START_LATENT=0.07
MEDITATION_VALIDATION_MIN_COMPLETIONS=50
MEDITATION_VALIDATION_MIN_HELPFUL_RATIO=0.80
MEDITATION_UNCERTAINTY_PENALTY=0.12
MEDITATION_LANGUAGE_BONUS=0.05
MEDITATION_MIN_CONFIDENCE=0.42
MEDITATION_MIN_SCORE=0.45

# ─── Crisis Helplines ─────────────────────────────────────
CRISIS_HELPLINE_TELE_MANAS=14416
CRISIS_HELPLINE_AASRA=+91-9820466726
CRISIS_HELPLINE_KIRAN=1800-599-0019
CRISIS_HELPLINE_VANDREVALA=+91-9999666555
